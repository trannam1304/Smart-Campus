    {
      "name": "Nhóm 2: Tra cứu & Lịch phòng & Sơ đồ tầng (FR-2.1 đến FR-2.4)",
      "description": "Kiểm thử hiển thị lịch trạng thái phòng (FR-2.1), sơ đồ mặt bằng tầng Visual Floor Map (FR-2.2), bộ lọc tìm kiếm (FR-2.3) và mã hóa màu sắc (FR-2.4).",
      "item": [
        {
          "name": "[FR-2.1 & FR-2.3 & NFR-01] Tra cứu danh sách phòng học có bộ lọc & phân trang",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rooms?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rooms"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[FR-2.1] Status code là 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test('[FR-2.3] Danh sách phòng trả về dạng mảng', function () {",
                  "    pm.expect(res.data).to.be.an('array');",
                  "    pm.expect(res.data.length).to.be.above(0);",
                  "});",
                  "if (res.data && res.data.length > 0) {",
                  "    pm.environment.set('test_room_id', res.data[0].roomId);",
                  "    var numId = res.data[0].roomId.replace('ROOM-', '');",
                  "    pm.environment.set('test_room_numeric_id', numId);",
                  "    if (res.data[0].equipments && res.data[0].equipments.length > 0) {",
                  "        pm.environment.set('test_equipment_id', res.data[0].equipments[0].id);",
                  "    }",
                  "}",
                  "pm.test('[FR-2.4] Mỗi phòng có trạng thái chuẩn (AVAILABLE / BOOKED / MAINTENANCE)', function () {",
                  "    pm.expect(['AVAILABLE', 'BOOKED', 'MAINTENANCE', 'DISABLED']).to.include(res.data[0].status);",
                  "});",
                  "pm.test('[NFR-01] Thời gian phản hồi API tra cứu < 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[FR-2.2] Tra cứu thông tin danh mục tòa nhà (Sơ đồ mặt bằng)",
