        {
          "name": "[FR-3.1 & FR-3.3 - Normal Flow] Tạo đơn đặt phòng học nhóm hợp lệ thành công",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tự động tính ngày tương lai (10 - 50 ngày) và khung giờ chuẩn địa phương (08:00 - 10:00)",
                  "const d = new Date();",
                  "const offset = Math.floor(10 + Math.random() * 40);",
                  "d.setDate(d.getDate() + offset);",
                  "const pad = (n) => String(n).padStart(2, '0');",
                  "const dateStr = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
                  "const start = `${dateStr}T08:00:00`;",
                  "const end = `${dateStr}T10:00:00`;",
                  "pm.environment.set('booking_start', start);",
                  "pm.environment.set('booking_end', end);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[FR-3.1] Tạo lượt đặt phòng thành công (HTTP 201 Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test('[FR-3.1] Trạng thái đơn được tạo và có mã bookingId', function () {",
                  "    pm.expect(res.data).to.have.property('bookingId');",
                  "    pm.environment.set('booking_id', res.data.bookingId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{test_room_id}}\",\n  \"numberOfPeople\": 3,\n  \"startTime\": \"{{booking_start}}\",\n  \"endTime\": \"{{booking_end}}\",\n  \"memberCodes\": [\n    \"{{student_code}}\",\n    \"52100001\",\n    \"52100002\"\n  ],\n  \"purpose\": \"Ki\\u1ec3m th\\u1eed t\\u00edch h\\u1ee3p chu\\u1ea9n ISO/IEC/IEEE 29148\"\n}"
            },
