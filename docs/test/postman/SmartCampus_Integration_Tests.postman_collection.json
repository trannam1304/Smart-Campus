          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[FR-1.1] Chặn email sai định dạng (HTTP 400 Bad Request)', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('[FR-1.1] Mã lỗi trả về là ERR_VALIDATION', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "    pm.expect(jsonData.errorCode).to.eql('ERR_VALIDATION');",
                  "});"
