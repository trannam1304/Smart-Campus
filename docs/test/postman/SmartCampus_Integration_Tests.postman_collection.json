            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van Test\",\n  \"studentCode\": \"52109998\",\n  \"email\": \"invalid_email@gmail.com\",\n  \"password\": \"Password@123\",\n  \"faculty\": \"Khoa CNTT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
