# Địa chỉ API Backend (ví dụ http://localhost:8080/api)
VITE_API_BASE_URL=http://localhost:8080/api

# Chế độ Mock Data
# - Đặt là 'true' (hoặc xóa/bỏ trống file này trong lúc DEV) để chạy Frontend với dữ liệu giả lập (không cần Backend).
# - Đặt là 'false' để kết nối tới Backend thật (VITE_API_BASE_URL).
VITE_USE_MOCK=false
